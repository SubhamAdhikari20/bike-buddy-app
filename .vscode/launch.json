{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bike Buddy: Android emulator",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/frontend/mobile",
      "program": "${workspaceFolder}/frontend/mobile/lib/main.dart",
      "deviceId": "emulator",
      "toolArgs": ["--dart-define=API_BASE_URL=http://10.0.2.2:5050"],
      "preLaunchTask": "Bike Buddy: prepare Android emulator"
    },
    {
      "name": "Bike Buddy: physical Android (USB; select phone first)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/frontend/mobile",
      "program": "${workspaceFolder}/frontend/mobile/lib/main.dart",
      "toolArgs": ["--dart-define=API_BASE_URL=http://127.0.0.1:5050"],
      "preLaunchTask": "Bike Buddy: prepare physical Android (USB)"
    },
    {
      "name": "Bike Buddy: desktop or web",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/frontend/mobile",
      "program": "${workspaceFolder}/frontend/mobile/lib/main.dart",
      "toolArgs": ["--dart-define=API_BASE_URL=http://localhost:5050"]
    },
    {
      "name": "Bike Buddy: physical phone (LAN / HTTPS)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/frontend/mobile",
      "program": "${workspaceFolder}/frontend/mobile/lib/main.dart",
      "toolArgs": ["--dart-define=API_BASE_URL=${input:bikeBuddyServerOrigin}"]
    }
  ],
  "inputs": [
    {
      "id": "bikeBuddyServerOrigin",
      "type": "promptString",
      "description": "Server origin only; never add /api/v1. Use the PC's current LAN URL for Android debug or an HTTPS origin for iPhone/release.",
      "default": "https://your-bike-buddy-api.example.com"
    }
  ]
}
