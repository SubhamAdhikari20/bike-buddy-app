{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bike Buddy: prepare Android emulator",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/run-mobile-android.ps1",
        "-Mode",
        "emulator",
        "-PrepareOnly"
      ],
      "problemMatcher": []
    },
