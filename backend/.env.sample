# Runtime
NODE_ENV=development
BACKEND_URL=http://localhost:5050
FRONTEND_URL=http://localhost:3000
PORT=5050
CORS_ORIGIN=http://localhost:3000

# Database and authentication
MONGODB_URI=
# Optional comma-separated DNS resolvers for networks that block SRV lookups.
MONGODB_DNS_SERVERS=
JWT_SECRET=
JWT_SIGNUP_EXPIRES_IN=
JWT_LOGIN_EXPIRES_IN=
GOOGLE_CLIENT_IDS=

# Payments
# demo is a clearly-labelled local simulation; live rejects payment attempts
# until a verified provider adapter and merchant credentials are configured.
PAYMENT_MODE=demo

# Email delivery
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Media storage
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
MEDIA_STORAGE_PROVIDER=local
