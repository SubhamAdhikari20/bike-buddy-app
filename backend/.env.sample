# Runtime
NODE_ENV=development
BACKEND_URL=
FRONTEND_URL=
PORT=
CORS_ORIGIN=

# Database and authentication
MONGODB_URI=
JWT_SECRET=
JWT_SIGNUP_EXPIRES_IN=
JWT_LOGIN_EXPIRES_IN=
GOOGLE_CLIENT_IDS=

# Payments
# demo is a clearly-labelled local simulation; live rejects payment attempts
# until a verified provider adapter and merchant credentials are configured.
PAYMENT_MODE=demo

# Email delivery
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Media storage
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
MEDIA_STORAGE_PROVIDER=local
