# Runtime
NODE_ENV=development
BACKEND_URL=http://localhost:5050
FRONTEND_URL=http://localhost:3000
# Listen on every local network interface so Android emulators and physical
# devices can reach the development API. Use a deployment-specific value in
# production when the process should bind to only one interface.
HOST=0.0.0.0
PORT=5050
CORS_ORIGIN=http://localhost:3000

# Database and authentication
MONGODB_URI=
# Optional comma-separated DNS resolvers for networks that block SRV lookups.
MONGODB_DNS_SERVERS=
JWT_SECRET=
JWT_SIGNUP_EXPIRES_IN=
JWT_LOGIN_EXPIRES_IN=
GOOGLE_CLIENT_IDS=

# Payments
# demo: local simulation with an explicit success/failure control and no gateway.
# sandbox: provider-hosted test checkout only. Use test merchant credentials.
# live: deliberately rejected until a separate production readiness review.
PAYMENT_MODE=demo
# Required only for sandbox. This must be an explicit public HTTPS origin (for
# example an HTTPS tunnel); provider sandboxes cannot call localhost/emulators.
PAYMENT_PUBLIC_BASE_URL=
# Public website origin sent to Khalti. Defaults are intentionally not inferred
# from request headers. Use the web portal or the public tunnel origin.
PAYMENT_WEBSITE_URL=
# Server-only sandbox merchant secrets. Never add these to Flutter/web builds.
KHALTI_SANDBOX_SECRET_KEY=
ESEWA_SANDBOX_SECRET_KEY=
# Independent random secret (32+ characters) for short-lived eSewa bridge URLs.
PAYMENT_CHECKOUT_SIGNING_SECRET=
# Provider calls time out and status polling is throttled server-side.
PAYMENT_PROVIDER_TIMEOUT_MS=8000
PAYMENT_LOOKUP_INTERVAL_MS=15000
# Unpaid booking requests expire so abandoned holds cannot block a bike.
BOOKING_HOLD_MINUTES=30

# Durable inbox retention and single-process live-stream connection caps.
# MongoDB remains the replay source; live fan-out is local to one API process.
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_MAX_CONNECTIONS_PER_USER=3
NOTIFICATION_MAX_CONNECTIONS_TOTAL=500

# Email delivery
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Media storage
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
MEDIA_STORAGE_PROVIDER=local
