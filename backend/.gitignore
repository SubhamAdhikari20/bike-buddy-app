# Dependencies
node_modules/
dist/
*.tsbuildinfo
.env
!.env.sample
src/config/config.env

# Files uploaded at runtime by multer (bike photos, profile pictures, KYC).
# The folders are recreated on demand, so only the .gitkeep files are tracked.
uploads/*
!uploads/.gitkeep
!uploads/bike/
uploads/bike/*
!uploads/bike/.gitkeep
!uploads/profile/
uploads/profile/*
!uploads/profile/.gitkeep
!uploads/kyc/
uploads/kyc/*
!uploads/kyc/.gitkeep
!uploads/evidence/
uploads/evidence/*
!uploads/evidence/.gitkeep
public/uploads

# Environment variables
# .env
# config/config.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Uploaded files (except defaults)
public/profile_pictures/*
!public/profile_pictures/default-profile.png
public/item_photos/*
!public/item_photos/default.jpg
public/item_videos/*

# Testing
coverage/

# Documentation (exclude internal notes)
TEACHING_NOTES.md
FINAL_REVIEW.md
db_design.md
API_TESTING.md

# Misc
